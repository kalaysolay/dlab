POSTGRES_DB=damulab
POSTGRES_USER=damulab
POSTGRES_PASSWORD=change-me

# Подтверждение email через HTTP API SMTP.BZ. EMAIL_FROM должен принадлежать
# домену отправителя, подтверждённому в личном кабинете SMTP.BZ.
EMAIL_VERIFICATION_ENABLED=false
APP_PUBLIC_BASE_URL=http://localhost:8080
EMAIL_API_BASE_URL=https://api.smtp.bz/v1
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_NAME=Damulab

# AI: провайдер и модель выбираются в /admin/settings/ai и хранятся в БД.
# Здесь остаются только endpoint-ы, секреты и аварийный выключатель внешних запросов.
AI_REAL_PROVIDERS_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
