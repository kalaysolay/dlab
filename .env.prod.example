# Скопируйте в .env.prod и выполните: chmod 600 .env.prod
# Файл .env.prod не должен попадать в Git.
POSTGRES_DB=damulab
POSTGRES_USER=damulab
POSTGRES_PASSWORD=replace-with-a-long-random-password

# AI. Для запуска без внешних AI-вызовов установите AI_PROVIDER=stub.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=
AI_REAL_PROVIDERS_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.2
OPENAI_MINI_LECTURE_MODEL=gpt-4o
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MINI_LECTURE_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Web Push. Пустые значения отключают реальную отправку push-уведомлений.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@damulab.kz

# Passkeys / WebAuthn.
WEBAUTHN_RP_ID=damulab.kz
WEBAUTHN_RP_NAME=Damulab.kz
WEBAUTHN_ALLOWED_ORIGINS=https://damulab.kz
