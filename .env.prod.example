# Скопируйте в .env.prod и выполните: chmod 600 .env.prod
# Файл .env.prod не должен попадать в Git.
POSTGRES_DB=damulab
POSTGRES_USER=damulab
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Подтверждение email через HTTP API SMTP.BZ.
EMAIL_VERIFICATION_ENABLED=true
APP_PUBLIC_BASE_URL=https://damulab.kz
EMAIL_API_BASE_URL=https://api.smtp.bz/v1
EMAIL_API_KEY=
# Адрес на подтверждённом в SMTP.BZ домене, например no-reply@damulab.kz.
EMAIL_FROM=
EMAIL_SENDER_NAME=Damulab

# Google OAuth. Создайте Web application client и добавьте callback:
# https://damulab.kz/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI. Провайдер и модель выбираются в админке; секреты остаются только на сервере.
AI_REAL_PROVIDERS_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Web Push. Пустые значения отключают реальную отправку push-уведомлений.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@damulab.kz

# Passkeys / WebAuthn.
WEBAUTHN_RP_ID=damulab.kz
WEBAUTHN_RP_NAME=Damulab.kz
WEBAUTHN_ALLOWED_ORIGINS=https://damulab.kz
