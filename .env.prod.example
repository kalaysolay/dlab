# Скопируйте в .env.prod и выполните: chmod 600 .env.prod
# Файл .env.prod не должен попадать в Git.
POSTGRES_DB=damulab
POSTGRES_USER=damulab
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Подтверждение email через HTTP API SMTP.BZ.
EMAIL_VERIFICATION_ENABLED=true
APP_PUBLIC_BASE_URL=https://damulab.kz
EMAIL_API_BASE_URL=https://api.smtp.bz/v1
EMAIL_API_KEY=
# Адрес на подтверждённом в SMTP.BZ домене, например no-reply@damulab.kz.
EMAIL_FROM=
EMAIL_SENDER_NAME=Damulab
PARENT_LINK_INVITATION_TOKEN_TTL=24h
PARENT_LINK_INVITATION_RESEND_COOLDOWN=1m

# Google OAuth. Создайте Web application client и добавьте callback:
# https://damulab.kz/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI. Провайдер и модель выбираются в админке; секреты остаются только на сервере.
AI_REAL_PROVIDERS_ENABLED=true
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Разговорник. До приёмки пилота выключен; включать отдельно и только разрешённым ученикам.
SPEAKING_ENABLED=false
SPEAKING_PILOT_ONLY=true
SPEAKING_ALLOWED_STUDENT_IDS=
SPEAKING_CLOUD_ENABLED=false
SPEAKING_VOICE_ENABLED=false
SPEAKING_STT_PROVIDER=deepgram
STT_API_KEY_DEEPGRAM=
SPEAKING_SPEECH_ENABLED=false
SPEAKING_SPEECH_MODEL=gpt-4o-mini-tts
# Консервативные резервы USD, не фактический счёт провайдера; пересматривать при смене тарифа.
SPEAKING_BUDGET_STUDENT_USD=3.00
SPEAKING_BUDGET_MODULE_USD=20.00
SPEAKING_RESERVE_LLM_USD=0.05
SPEAKING_RESERVE_STT_USD=0.02
SPEAKING_RESERVE_SPEECH_USD=0.10
SPEAKING_PRICED_LLM_MODELS=OPENAI:gpt-4.1-mini,DEEPSEEK:deepseek-flash

# Web Push. Пустые значения отключают реальную отправку push-уведомлений.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@damulab.kz

# Passkeys / WebAuthn.
WEBAUTHN_RP_ID=damulab.kz
WEBAUTHN_RP_NAME=Damulab.kz
WEBAUTHN_ALLOWED_ORIGINS=https://damulab.kz

# Доверенная сессия личного устройства. Оба срока держим одинаковыми.
SESSION_TIMEOUT=36h
SESSION_COOKIE_MAX_AGE=36h
# Недельные отчёты родителям: polling локально, webhook после настройки публичного HTTPS.
TELEGRAM_REPORTS_ENABLED=false
TELEGRAM_MODE=webhook
TELEGRAM_BOT_USERNAME=damulab_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
